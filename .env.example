# Copy to .env.local and fill in ONE of the keys. With no key the app runs in practice mode (example nags).
# Never commit real keys.

# Google Gemini — has a free tier: https://aistudio.google.com
# Note: on the free tier Google may use what you send to improve its products.
GEMINI_API_KEY=

# Anthropic Claude — paid: https://console.anthropic.com
ANTHROPIC_API_KEY=

# optional: force one when both keys are set (gemini | claude)
AI_PROVIDER=

# optional model overrides (defaults: gemini-3.5-flash-lite with gemini-3.8-flash as backup, claude-haiku-5-5)
GEMINI_MODEL=
CLAUDE_MODEL=

# Supabase (optional) — rate limits + "today" counter. Without it, limits live in memory.
# Run supabase/schema.sql in the SQL Editor first. Use the SECRET key (sb_secret_...), server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# requests allowed per Toronto day for everyone (default 300)
NAG_DAILY_CAP=
