# Copy to .env.local and fill in ONE of the keys. With no key the app runs in practice mode (example nags).
# Never commit real keys.

# Google Gemini — has a free tier: https://aistudio.google.com
# Note: on the free tier Google may use what you send to improve its products.
GEMINI_API_KEY=

# Anthropic Claude — paid: https://console.anthropic.com
ANTHROPIC_API_KEY=

# optional: force one when both keys are set (gemini | claude)
AI_PROVIDER=

# optional model overrides (defaults: gemini-3.8-flash, claude-haiku-5-5)
GEMINI_MODEL=
CLAUDE_MODEL=
